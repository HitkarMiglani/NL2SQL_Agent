NL2SQL_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database
DATABASE_PATH=data/enterprise.db
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_S=30

# Retrieval / indexing
CHROMA_PERSIST_DIR=chroma_store
NL2SQL_COLLECTION_NAME=enterprise_schema_demo
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
DEFAULT_TOP_K=3
SCHEMA_CONFIDENCE_THRESHOLD=0.5

# Agent
MAX_RETRY_COUNT=3

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=text

# LangSmith tracing (https://smith.langchain.com)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nl2sql-studio
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM-as-judge response scoring (adds one extra LLM call per query)
ENABLE_LLM_JUDGE=true
